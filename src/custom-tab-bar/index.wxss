.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding: 4rpx 12rpx env(safe-area-inset-bottom);
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255, 255, 255, .97);
  border-top: 2rpx solid rgba(226, 232, 240, .8);
  box-shadow: 0 -8rpx 28rpx rgba(15, 23, 42, .04);
  box-sizing: border-box;
}

.tab {
  position: relative;
  width: 20%;
  height: 104rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  color: #475569;
  font-size: 20rpx;
  line-height: 1;
}

.icon {
  width: 39rpx;
  height: 39rpx;
  opacity: .58;
}

.active {
  color: #072eaa;
  font-weight: 700;
}

.active .icon {
  opacity: 1;
}

.active::after {
  content: '';
  position: absolute;
  top: -4rpx;
  width: 34rpx;
  height: 5rpx;
  border-radius: 0 0 8rpx 8rpx;
  background: #164ac7;
}
